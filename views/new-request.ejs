<!DOCTYPE html>
<html>
<%- include('partials/head') %>
<body>
  <div class="app-shell">
    <%- include('partials/nav', { name, role, currentPath }) %>
    <main class="page">
      <div class="page-header">
        <div>
          <h1>New Request</h1>
          <p class="muted">Submitting as <strong><%= name %></strong></p>
        </div>
      </div>

      <form method="POST" action="/requests" class="card request-form">
        <label>
          Type
          <select name="type" required>
            <option value="pto">PTO</option>
            <option value="equipment">Equipment</option>
            <option value="onboarding">Onboarding</option>
            <option value="policy_question">Policy question</option>
            <option value="other">Other</option>
          </select>
        </label>

        <label>
          Description
          <textarea name="description" required rows="5"></textarea>
        </label>

        <button type="submit">Submit request</button>
      </form>
    </main>
  </div>
</body>
</html>
