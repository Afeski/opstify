<!DOCTYPE html>
<html>
<%- include('partials/head') %>
<body>
  <div class="app-shell">
    <%- include('partials/nav', { name, role, currentPath }) %>
  <main class="page">
    <%- include('partials/flash', { flash }) %>
    <p><a href="/dashboard">&larr; Back to dashboard</a></p>

    <div class="page-header">
      <div>
        <h1>Request #<%= request.id %></h1>
        <p class="muted">
          <%= request.type.replace('_', ' ') %> &middot; submitted by <%= request.requester_name %>
          <% if (request.department || request.job_title) { %>
            (<%= [request.job_title, request.department].filter(Boolean).join(', ') %>)
          <% } %>
        </p>
        <p class="muted at-a-glance">
          <%= formatDuration(hoursSince(request.created_at)) %> old
          &middot; updated <%= timeAgo(request.updated_at) %>
          &middot; <%= activity.length %> activity event<%= activity.length === 1 ? '' : 's' %>
        </p>
      </div>
      <span>
        <span class="badge badge-<%= request.status %>"><%= STATUS_LABELS[request.status] %></span>
        <% if (request.priority !== 'normal') { %>
          <span class="priority priority-<%= request.priority %>">&#9679; <%= PRIORITY_LABELS[request.priority] %></span>
        <% } %>
      </span>
    </div>

    <div class="card">
      <h2>Description</h2>
      <p class="preserve-whitespace"><%= request.description %></p>

      <h2>Admin notes</h2>
      <p class="preserve-whitespace muted"><%= request.admin_notes || 'No notes yet.' %></p>

      <p class="muted">
        Submitted <%= request.created_at %> &middot; Last updated <%= request.updated_at %>
        &middot; <%= request.assignee_name ? 'Assigned to ' + request.assignee_name : 'Unassigned' %>
      </p>
    </div>

    <div class="card">
      <h2>Activity</h2>
      <ul class="activity-list">
        <% activity.forEach(function(entry) { %>
          <li class="activity-item">
            <p class="activity-detail"><%= entry.detail %></p>
            <p class="activity-meta muted"><%= entry.actor_name || 'System' %> &middot; <%= entry.created_at %></p>
          </li>
        <% }); %>
      </ul>
    </div>

    <% if (role === 'admin') { %>
      <div class="card">
        <h2>Update status</h2>
        <% if (request.assigned_to !== currentUserId) { %>
          <form method="POST" action="/requests/<%= request.id %>/status" class="inline-action">
            <input type="hidden" name="next" value="/requests/<%= request.id %>">
            <input type="hidden" name="status" value="<%= request.status %>">
            <input type="hidden" name="priority" value="<%= request.priority %>">
            <input type="hidden" name="admin_notes" value="<%= request.admin_notes || '' %>">
            <input type="hidden" name="assigned_to" value="<%= currentUserId %>">
            <button type="submit" class="link-button">Assign to me</button>
          </form>
        <% } %>

        <% if (request.ai_suggested_priority) { %>
          <div class="ai-suggestion">
            <span>&#10024; AI suggests <strong><%= PRIORITY_LABELS[request.ai_suggested_priority] %></strong> &mdash; <%= request.ai_suggestion_rationale %></span>
            <% if (request.ai_suggested_priority !== request.priority) { %>
              <form method="POST" action="/requests/<%= request.id %>/status" class="inline-action">
                <input type="hidden" name="next" value="/requests/<%= request.id %>">
                <input type="hidden" name="status" value="<%= request.status %>">
                <input type="hidden" name="priority" value="<%= request.ai_suggested_priority %>">
                <input type="hidden" name="admin_notes" value="<%= request.admin_notes || '' %>">
                <input type="hidden" name="assigned_to" value="<%= request.assigned_to || '' %>">
                <button type="submit" class="link-button">Use this</button>
              </form>
            <% } %>
          </div>
        <% } else if (geminiEnabled) { %>
          <form method="POST" action="/requests/<%= request.id %>/ai-suggest-priority" class="inline-action ai-suggest-form">
            <button type="submit" class="link-button">&#10024; Get AI priority suggestion</button>
          </form>
        <% } %>

        <% if (request.ai_suggested_assignee) { %>
          <div class="ai-suggestion">
            <span>&#10024; AI suggests <strong><%= request.ai_suggested_assignee_name %></strong> &mdash; <%= request.ai_suggestion_assignee_rationale %></span>
            <% if (request.ai_suggested_assignee !== request.assigned_to) { %>
              <form method="POST" action="/requests/<%= request.id %>/status" class="inline-action">
                <input type="hidden" name="next" value="/requests/<%= request.id %>">
                <input type="hidden" name="status" value="<%= request.status %>">
                <input type="hidden" name="priority" value="<%= request.priority %>">
                <input type="hidden" name="admin_notes" value="<%= request.admin_notes || '' %>">
                <input type="hidden" name="assigned_to" value="<%= request.ai_suggested_assignee %>">
                <button type="submit" class="link-button">Assign to <%= request.ai_suggested_assignee_name %></button>
              </form>
            <% } %>
          </div>
        <% } else if (geminiEnabled) { %>
          <form method="POST" action="/requests/<%= request.id %>/ai-suggest-assignee" class="inline-action ai-suggest-form">
            <button type="submit" class="link-button">&#10024; Get AI assignee suggestion</button>
          </form>
        <% } %>

        <form method="POST" action="/requests/<%= request.id %>/status">
          <input type="hidden" name="next" value="/requests/<%= request.id %>">
          <label>
            Status
            <select name="status">
              <option value="open" <%= request.status === 'open' ? 'selected' : '' %>>Open</option>
              <option value="in_progress" <%= request.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
              <option value="resolved" <%= request.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
            </select>
          </label>
          <label>
            Priority
            <select name="priority">
              <option value="low" <%= request.priority === 'low' ? 'selected' : '' %>>Low</option>
              <option value="normal" <%= request.priority === 'normal' ? 'selected' : '' %>>Normal</option>
              <option value="high" <%= request.priority === 'high' ? 'selected' : '' %>>High</option>
              <option value="urgent" <%= request.priority === 'urgent' ? 'selected' : '' %>>Urgent</option>
            </select>
          </label>
          <label>
            Assigned to
            <select name="assigned_to">
              <option value="">Unassigned</option>
              <% adminUsers.forEach(function(u) { %>
                <option value="<%= u.id %>" <%= request.assigned_to === u.id ? 'selected' : '' %>><%= u.name %></option>
              <% }); %>
            </select>
          </label>
          <label>
            Internal notes
            <textarea name="admin_notes" rows="4"><%= request.admin_notes || '' %></textarea>
          </label>
          <button type="submit">Update</button>
        </form>
      </div>
    <% } %>
  </main>
  </div>
</body>
</html>
