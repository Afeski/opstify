<aside class="sidebar">
  <div class="sidebar-brand">
    <a href="/dashboard" class="brand">Opstify</a>
  </div>

  <nav class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= currentPath === '/dashboard' ? 'active' : '' %>">
      <%= role === 'field_worker' ? 'My Profile' : 'Dashboard' %>
    </a>
    <a href="/documents" class="sidebar-link <%= currentPath.startsWith('/documents') ? 'active' : '' %>">Documents</a>
    <a href="/ask" class="sidebar-link <%= currentPath === '/ask' ? 'active' : '' %>">Ask</a>
    <% if (role === 'employee') { %>
      <a href="/requests/new" class="sidebar-link <%= currentPath === '/requests/new' ? 'active' : '' %>">New request</a>
    <% } %>
    <% if (role === 'admin' || role === 'employee') { %>
      <a href="/people" class="sidebar-link <%= currentPath === '/people' ? 'active' : '' %>">People</a>
    <% } %>
    <% if (role === 'admin') { %>
      <a href="/analytics" class="sidebar-link <%= currentPath === '/analytics' ? 'active' : '' %>">Analytics</a>
      <a href="/ask/log" class="sidebar-link <%= currentPath === '/ask/log' ? 'active' : '' %>">Query Log</a>
    <% } %>
  </nav>

  <div class="sidebar-user">
    <span class="nav-role"><%= role === 'admin' ? 'PeopleOps admin' : (role === 'field_worker' ? 'Field worker' : 'Employee') %></span>
    <span class="nav-name"><%= name %></span>
    <a href="/logout" class="nav-logout">Sign out</a>
  </div>
</aside>
