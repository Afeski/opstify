<aside class="sidebar">
  <div class="sidebar-brand">
    <a href="/dashboard" class="brand">Opstify</a>
  </div>

  <nav class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= currentPath === '/dashboard' ? 'active' : '' %>">Dashboard</a>
    <% if (role === 'employee') { %>
      <a href="/requests/new" class="sidebar-link <%= currentPath === '/requests/new' ? 'active' : '' %>">New request</a>
    <% } %>
  </nav>

  <div class="sidebar-user">
    <span class="nav-role"><%= role === 'admin' ? 'PeopleOps admin' : 'Employee' %></span>
    <span class="nav-name"><%= name %></span>
    <a href="/logout" class="nav-logout">Sign out</a>
  </div>
</aside>
