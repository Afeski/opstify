<!DOCTYPE html>
<html>
<%- include('partials/head') %>
<body class="landing-body">
  <header class="landing-header">
    <span class="brand">Opstify</span>
    <nav class="landing-nav-links">
      <a href="#features">Features</a>
      <a href="https://github.com/Afeski/opstify" target="_blank" rel="noopener">GitHub</a>
    </nav>
    <a href="<%= loggedIn ? '/dashboard' : '/login' %>" class="button-link">
      <%= loggedIn ? 'Go to Dashboard' : 'Sign In' %>
    </a>
  </header>

  <section class="hero">
    <div class="hero-dot-grid" aria-hidden="true"></div>
    <div class="hero-bubble hero-bubble--1" aria-hidden="true"><span>&#128203;</span></div>
    <div class="hero-bubble hero-bubble--2" aria-hidden="true"><span>&#128187;</span></div>
    <div class="hero-bubble hero-bubble--3" aria-hidden="true"><span>&#9989;</span></div>
    <div class="hero-bubble hero-bubble--4" aria-hidden="true"><span>&#10067;</span></div>

    <div class="hero-content">
      <p class="eyebrow-pill">&#9889; Internal PeopleOps tool</p>
      <h1>One tool to <span class="hero-underline">manage</span> all <span class="hero-highlight">your team requests</span></h1>
      <p class="hero-tagline">
        Employees submit requests in seconds. PeopleOps gets one queue to
        search, prioritize, assign, and resolve them — no more scattered
        email threads.
      </p>

      <% if (loggedIn) { %>
        <div class="hero-actions">
          <a href="/dashboard" class="button-link hero-cta">Go to Dashboard</a>
          <a href="#features" class="hero-secondary">See what's included &darr;</a>
        </div>
      <% } else { %>
        <div class="hero-actions hero-actions--portals">
          <a href="/login?role=employee" class="button-link hero-cta">Employee Portal</a>
          <a href="/login?role=admin" class="button-link hero-cta hero-cta--secondary">PeopleOps Portal</a>
        </div>
        <a href="#features" class="hero-secondary">See what's included &darr;</a>
      <% } %>

      <div class="hero-photo">
        <img
          class="hero-image"
          src="/images/hero-team.jpg"
          alt="A PeopleOps team reviewing requests together on their laptops"
          width="900"
          height="600"
        >
      </div>

      <div class="tech-strip">
        <p class="tech-strip-label">Built with</p>
        <div class="tech-strip-marks">
          <span>Node.js</span>
          <span>Express</span>
          <span>SQLite</span>
          <span>Gemini</span>
        </div>
      </div>
    </div>
  </section>

  <section class="feature-section" id="features">
    <div class="feature-section-header">
      <p class="eyebrow-pill">Features</p>
      <h2>Everything PeopleOps needs, nothing it doesn't</h2>
      <p class="muted feature-section-subtitle">
        Submit a PTO, equipment, onboarding, or policy request in seconds — then search, filter,
        prioritize, and resolve it from one shared queue.
      </p>
    </div>

    <div class="feature-asymmetric-grid">
      <div class="card feature-card feature-hero-card">
        <div class="feature-hero-text">
          <h3>See the whole queue at a glance</h3>
          <p class="muted">
            Live totals, resolution time, and submission trends — PeopleOps sees exactly where
            things stand without digging through email threads.
          </p>
          <a href="/login?role=admin" class="button-link">Sign in to explore</a>
        </div>
        <div class="feature-hero-mockup" aria-hidden="true">
          <div class="mockup-stats">
            <div class="mockup-stat"><span class="mockup-stat-value">24</span><span class="mockup-stat-label">Open</span></div>
            <div class="mockup-stat"><span class="mockup-stat-value">17</span><span class="mockup-stat-label">In progress</span></div>
            <div class="mockup-stat"><span class="mockup-stat-value">87</span><span class="mockup-stat-label">Resolved</span></div>
          </div>
          <div class="mockup-bars">
            <span style="height: 35%"></span>
            <span style="height: 55%"></span>
            <span style="height: 30%"></span>
            <span style="height: 75%"></span>
            <span style="height: 45%"></span>
            <span style="height: 90%"></span>
            <span style="height: 60%"></span>
          </div>
        </div>
      </div>

      <div class="card feature-card feature-small-card">
        <h3>Prioritize &amp; assign</h3>
        <p class="muted">Flag what's urgent and assign it to the right person, so nothing falls through the cracks.</p>
        <div class="mockup-priority-list" aria-hidden="true">
          <div class="mockup-priority-row">
            <span class="badge badge-open">Open</span>
            <span class="priority priority-urgent">&#9679; Urgent</span>
          </div>
          <div class="mockup-priority-row">
            <span class="badge badge-in_progress">In progress</span>
            <span class="priority priority-high">&#9679; High</span>
          </div>
        </div>
      </div>

      <div class="card feature-card feature-small-card">
        <h3>Track activity in real time</h3>
        <p class="muted">Every status change, note, and reassignment — logged automatically and timestamped.</p>
        <ul class="mockup-activity-list" aria-hidden="true">
          <li><span class="mockup-activity-dot"></span> Status changed to In progress</li>
          <li><span class="mockup-activity-dot"></span> Assigned to Priya</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="capabilities-section">
    <p class="eyebrow-pill eyebrow-pill--dark">Capabilities</p>
    <h2>Built to work the way PeopleOps already does</h2>
    <p class="capabilities-subtitle">Real, shipped capabilities — not a wishlist.</p>
    <div class="capabilities-grid">
      <div class="capability-item"><span class="capability-icon">&#10024;</span><span>AI-suggested priority</span></div>
      <div class="capability-item"><span class="capability-icon">&#127919;</span><span>AI-suggested assignee</span></div>
      <div class="capability-item"><span class="capability-icon">&#128203;</span><span>Full activity timeline</span></div>
      <div class="capability-item"><span class="capability-icon">&#128202;</span><span>PeopleOps analytics</span></div>
    </div>
  </section>

  <section class="footer-cta">
    <div class="footer-cta-inner">
      <h2>Ready to see Opstify in action?</h2>
      <a href="<%= loggedIn ? '/dashboard' : '/login' %>" class="button-link footer-cta-button">
        <%= loggedIn ? 'Go to Dashboard' : 'Sign In' %>
      </a>
    </div>
  </section>

  <footer class="landing-footer">
    <div class="landing-footer-inner">
      <div class="landing-footer-brand">
        <span class="brand">Opstify</span>
        <p>Internal PeopleOps tool</p>
      </div>
      <div class="landing-footer-links">
        <a href="/login?role=employee">Employee Portal</a>
        <a href="/login?role=admin">PeopleOps Portal</a>
        <a href="https://github.com/Afeski/opstify" target="_blank" rel="noopener">GitHub</a>
      </div>
    </div>
    <p class="landing-footer-copyright">&copy; 2026 Opstify</p>
  </footer>
</body>
</html>
