<!DOCTYPE html>
<html>
<%- include('partials/head') %>
<body>
  <div class="app-shell">
    <%- include('partials/nav', { name, role, currentPath }) %>
  <main class="page">
    <%- include('partials/flash', { flash }) %>
    <div class="page-header">
      <div>
        <h1>My Requests</h1>
        <p class="muted">Everything you've submitted to PeopleOps</p>
      </div>
      <a href="/requests/new" class="button-link">+ New request</a>
    </div>

    <%- include('partials/stats', { stats }) %>

    <% if (requests.length === 0) { %>
      <div class="empty-state">
        <p>You haven't submitted any requests yet.</p>
        <a href="/requests/new">Submit your first request</a>
      </div>
    <% } else { %>
      <div class="request-card-grid">
        <% requests.forEach(function(r) { %>
          <a href="/requests/<%= r.id %>" class="card request-card">
            <div class="request-card-header">
              <span class="type-cell"><%= r.type.replace('_', ' ') %></span>
              <span class="badge badge-<%= r.status %>"><%= STATUS_LABELS[r.status] %></span>
            </div>
            <p class="request-card-description"><%= r.description %></p>
            <% if (r.priority !== 'normal' || r.status !== 'resolved') { %>
              <div class="request-card-meta">
                <% if (r.priority !== 'normal') { %>
                  <span class="priority priority-<%= r.priority %>">&#9679; <%= PRIORITY_LABELS[r.priority] %></span>
                <% } %>
                <% if (r.status !== 'resolved') { %>
                  <span class="age-indicator">open <%= formatDuration(hoursSince(r.created_at)) %></span>
                <% } %>
              </div>
            <% } %>
            <div class="request-card-footer">
              <span class="muted"><%= r.assignee_name ? 'Assigned to ' + r.assignee_name : 'Unassigned' %></span>
              <span class="muted" title="<%= r.created_at %>"><%= timeAgo(r.created_at) %></span>
            </div>
          </a>
        <% }); %>
      </div>
    <% } %>
  </main>
  </div>
</body>
</html>
