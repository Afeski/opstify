<!DOCTYPE html>
<html>
<head>
  <title>All Requests - PeopleOps Tool</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <h1>All Requests</h1>
  <p>Logged in as <strong><%= name %></strong> (admin)</p>

  <% if (requests.length === 0) { %>
    <p>No requests have been submitted yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Requester</th>
          <th>Type</th>
          <th>Description</th>
          <th>Submitted</th>
          <th>Status &amp; notes</th>
        </tr>
      </thead>
      <tbody>
        <% requests.forEach(function(r) { %>
          <tr>
            <td><%= r.requester_name %></td>
            <td><%= r.type %></td>
            <td><%= r.description %></td>
            <td><%= r.created_at %></td>
            <td>
              <form method="POST" action="/requests/<%= r.id %>/status">
                <select name="status">
                  <option value="open" <%= r.status === 'open' ? 'selected' : '' %>>Open</option>
                  <option value="in_progress" <%= r.status === 'in_progress' ? 'selected' : '' %>>In progress</option>
                  <option value="resolved" <%= r.status === 'resolved' ? 'selected' : '' %>>Resolved</option>
                </select>
                <textarea name="admin_notes" rows="2" placeholder="Internal notes"><%= r.admin_notes || '' %></textarea>
                <button type="submit">Update</button>
              </form>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
